rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anonymous clients can only create solicitudes (no auth required)
    // Admins can read, update, and delete
    match /solicitudes/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Zonas: public read (clients need prices for booking), admin write
    match /zonas/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /choferes/{id} {
      allow read, write: if request.auth != null;
    }

    match /bloqueadas/{id} {
      allow read, write: if request.auth != null;
    }

    match /registroViajes/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
